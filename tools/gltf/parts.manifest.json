{
  "version": 1,
  "purpose": "Machine-readable authoring contract for Ironfield modular IMSH unit meshes. maxTris values are a ratchet: parts and assembled rigs may shrink, but never grow without a conscious manifest edit.",
  "axes": {
    "up": "+Y",
    "forward": "+Z",
    "units": "metres"
  },
  "materialSlots": {
    "0": "neutral / bone / teeth",
    "1": "team cloth",
    "2": "team dark cloth",
    "3": "team trim / heraldry",
    "4": "bright steel",
    "5": "mail / dark steel",
    "6": "brass / gold",
    "7": "leather",
    "8": "wood",
    "9": "skin",
    "10": "hair",
    "11": "coat or beast body",
    "12": "dark coat or beast accent",
    "13": "dark leather / shadow"
  },
  "pivots": {
    "unitBone": "Origin at the parent joint; the bone extends along +Y and is length-normalised to y=1. EmitBone scales +Y to the runtime joint distance. Toes/claws/muzzle details face +Z.",
    "bodySpace": "Humanoid body coordinates with the unit origin at the feet: chest, belt, skirt and shoulder layers are authored at their final heights.",
    "headJoint": "Origin at the neck/head joint. Faces/muzzles look +Z; helmets sit upward from this joint.",
    "grip": "Origin at the hand grip or rear end; the shaft/blade runs along +Y. Straight sword edges are +/-X; axes, curved blades and polearm bits are +/-Z.",
    "shieldFace": "Origin at the shield centre; the decorated face points +Z; local +Y is up.",
    "bodyCenter": "Origin inside the body mass at the emitter point; +Z is forward.",
    "wingRoot": "Origin at the wing shoulder/root; span along the authored lateral axis and feathers trail as sculpted.",
    "emblemPlane": "Flat relief in shield/tabard local space, front toward +Z.",
    "groundFigure": "A complete far-LOD figure with origin at the ground/feet.",
    "prop": "Miscellaneous authored pivot documented beside the part; keep the existing pivot stable."
  },
  "budgets": {
    "total": {
      "targetTris": 32000,
      "maxTris": 50876
    },
    "note": "maxTris is the committed baseline/ratchet. targetTris is where new or remade work should move. Never spend target budget on invisible detail: IMSH parts are CPU-re-emitted for every soldier, camera pass and shadow pass."
  },
