        { "label": "PAY A PRIEST TO SAY MASS", "need": "gold:60", "effects": ["gold:-60", "calm:6", "cohesion:1"] },
        { "label": "TELL THEM CROWS ARE CROWS", "effects": ["cohesion:-2", "calm:2"] }
