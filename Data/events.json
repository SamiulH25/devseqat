  "events": [
    {
      "id": "omen_birds", "trigger": "dark_omens", "cooldown": 14, "scene": "camp", "title": "CROWS OVER THE CAMP",
      "text": "Since the old craft was worked in your camp the crows have not left it. The men cross themselves and mutter.",
