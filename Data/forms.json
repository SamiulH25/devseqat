  // The captain's forms (docs/archive/KNIGHT_ORDERS.md 5.6; loaded by Forms.cs, used by BattleForms.cs). Forms are the only
  // techniques the player presses: three slots (U, I, O) and a great form (L, once a battle). Each costs aura and has
  // a cooldown. "tier" is the aura tier that opens it; "order" the knight order that teaches it ("" = anyone, "hollow"
  // = the Black Flame). Kinds:
  //   focus  breath back in full; your next blows land harder for `duration` s (damage = the share more)
  //   slash  a cut of aura thrown ahead: after `warn` s, up to `maxHit` foes in a `radius`-wide cone out to `range` m
  //   guard  for `duration` s every blow from the front stops on your guard, and the striker reels
  //   edge   your next `count` blows go through armour (pierce) and harder by `damage`
  //   shout  foes within `radius` lose `shock` morale and reel; `effect` on enemy companies there
  //   leap   to a foe in front within `range`, a heavy blow on landing, those within `radius` reel
  //   shot   (a bow in hand) an arrow of aura through up to `maxHit` men along a line out to `range`
  //   counter for `duration` s your parry window is wider and a parry strikes back for `damage` x your weapon
  //   buff   `effect` on your companies within `radius` for `duration` s (and routing men there rally)
  //   burst  up to `maxHit` foes within `radius` round you take `damage`; `shock` morale
  //   volley after `warn` s, up to `maxHit` foes within `radius` of a spot `range` m ahead take `damage`
  //   burn   a field of black fire `range` m ahead: `dps` to foes in `radius` for `duration` s, `effect` on them
  //   drain  foes within `radius` lose `damage` health; you gain half of it back as health and aura
  // Ranks: a form grows with use (Campaign.FormRank: 1-3, +15% a rank).
  "forms": [
    { "id": "focus", "name": "Focus", "icon": "star", "kind": "focus", "tier": 1, "aura": 15, "cooldown": 20, "duration": 6, "damage": 0.3,
      "line": "Breathe in the aura: your breath comes back and your next blows land harder." },
    { "id": "aura_slash", "name": "Aura Slash", "icon": "sword", "kind": "slash", "tier": 3, "aura": 25, "cooldown": 12, "warn": 0.35, "range": 7, "radius": 0.6, "maxHit": 4, "damage": 45, "shock": 6,
      "line": "Throw a cut of aura ahead of you: it strikes up to four men in front." },
    { "id": "aura_burst", "name": "Aura Burst", "icon": "sun", "kind": "burst", "tier": 4, "great": true, "aura": 60, "cooldown": 300, "radius": 6, "maxHit": 12, "damage": 60, "shock": 20,
      "line": "Once a battle: your aura bursts out and throws down every foe around you." },

