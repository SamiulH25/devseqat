{
  // What lords say when you talk to them (docs/archive/LORDS.md LD3; Campaign/Talk.cs). Each line: a topic ("greet" for the greeting),
  // and optionally a mood towards you (warm, even, cold, hostile), a temper (one of the lord traits), an outcome (yes, no) and
  // "war": true (only while his realm is at war with yours). The most fitting lines win. {name}, {house}, {realm}, {you}, {other}.
  "lines": [
    { "topic": "greet", "mood": "warm", "text": "Well met, {you}. Sit, there is wine." },
    { "topic": "greet", "mood": "warm", "text": "{you}! The men speak of you. Come, sit by the fire." },
    { "topic": "greet", "mood": "warm", "temper": "Honourable", "text": "An honest face is rare these days. Welcome, {you}." },
    { "topic": "greet", "mood": "warm", "temper": "Greedy", "text": "My friend the {you}. Business, I hope? Good business?" },
    { "topic": "greet", "mood": "warm", "temper": "Pious", "text": "The saints walk with you, {you}. Be welcome." },
    { "topic": "greet", "mood": "even", "text": "{you}. What brings you to {house}?" },
    { "topic": "greet", "mood": "even", "text": "Speak, {you}. I have little time." },
    { "topic": "greet", "mood": "even", "temper": "Cautious", "text": "You will forgive me if my guards stay close, {you}." },
    { "topic": "greet", "mood": "even", "temper": "Ambitious", "text": "A captain with men behind him. Perhaps we can be useful to each other." },
    { "topic": "greet", "mood": "even", "temper": "Reckless", "text": "Ha! Another sellsword. Can your men fight, or only eat?" },
    { "topic": "greet", "mood": "cold", "text": "You. Say what you came to say." },
    { "topic": "greet", "mood": "cold", "temper": "Cruel", "text": "I have hanged better men than you for less, {you}." },
    { "topic": "greet", "mood": "cold", "temper": "Honourable", "text": "I will hear you, {you}, because it is right. Do not mistake it for liking." },
    { "topic": "greet", "mood": "hostile", "text": "You have a nerve, riding up to me." },
    { "topic": "greet", "mood": "hostile", "temper": "Cruel", "text": "I will remember your face when they bring me your head." },
    { "topic": "greet", "war": true, "text": "The {realm} and yours are at war, {you}. Speak quickly." },
    { "topic": "greet", "war": true, "mood": "warm", "text": "Our realms are at war, {you}, but I bear you no hate. Speak." },

    { "topic": "news", "outcome": "yes", "text": "{other}" },
    { "topic": "news", "outcome": "yes", "mood": "hostile", "text": "Why should I tell you anything? ...Still. {other}" },
    { "topic": "lords", "outcome": "yes", "text": "{other}" },
    { "topic": "lords", "outcome": "yes", "temper": "Fickle", "text": "Friends change with the wind, {you}. Today: {other}" },
    { "topic": "wants", "outcome": "yes", "text": "{other}" },
    { "topic": "wants", "outcome": "yes", "mood": "hostile", "text": "What I want is none of your business. Though since you ask: {other}" },
    { "topic": "work", "outcome": "yes", "text": "There is something. {other}" },
    { "topic": "work", "outcome": "yes", "temper": "Greedy", "text": "I pay for results, not promises. {other}" },
    { "topic": "ride", "outcome": "yes", "text": "Very well. My banner rides with yours for three days." },
    { "topic": "ride", "outcome": "yes", "temper": "Reckless", "text": "Ride together? Gladly! Let us find someone to kill." },
    { "topic": "ride", "outcome": "no", "text": "I have my own road, {you}." },
    { "topic": "council", "outcome": "yes", "text": "When the council sits, I will speak for you." },
    { "topic": "council", "outcome": "yes", "temper": "Ambitious", "text": "I will back you. Remember who did, when you rise." },
    { "topic": "council", "outcome": "no", "text": "I owe you nothing in council." },
    { "topic": "peace", "outcome": "yes", "text": "Enough men have died. {other}" },
    { "topic": "peace", "outcome": "yes", "temper": "Cautious", "text": "You speak sense. This war bleeds us both. {other}" },
    { "topic": "peace", "outcome": "no", "text": "Peace? When we have won it, not before." },
    { "topic": "peace", "outcome": "no", "temper": "Reckless", "text": "Peace is for old men. I have battles yet to win." },
    { "topic": "defect", "outcome": "yes", "text": "My king has never valued me. Very well: I am yours." },
    { "topic": "defect", "outcome": "no", "text": "I swore an oath, {you}. Do not ask me again." },
    { "topic": "defect", "outcome": "no", "temper": "Honourable", "text": "You would have me break faith? Get out of my sight." },
    { "topic": "demand", "outcome": "yes", "text": "...Take it, and go. {other}" },
    { "topic": "demand", "outcome": "no", "text": "You will have steel, not silver." },
    { "topic": "demand", "outcome": "no", "temper": "Reckless", "text": "Ha! Come and take it, then!" },
    { "topic": "gift", "outcome": "yes", "text": "Generous of you, {you}." },
    { "topic": "gift", "outcome": "yes", "temper": "Greedy", "text": "Ah. Now you speak a language I understand." },
    { "topic": "gift", "outcome": "yes", "temper": "Generous", "text": "Keep your gold, {you}... no? Then I thank you." },
    { "topic": "gift_horse", "outcome": "yes", "text": "A fine beast. I will ride her into battle." },
    { "topic": "gift_horse", "outcome": "yes", "temper": "Cautious", "text": "A horse. Useful. Thank you." },
    { "topic": "insult", "outcome": "yes", "text": "You will regret those words." },
    { "topic": "insult", "outcome": "yes", "temper": "Reckless", "text": "Draw, then, if you dare say it again!" },
    { "topic": "insult", "outcome": "yes", "temper": "Cautious", "text": "Words cost nothing. Their price comes later." },
    { "topic": "court", "outcome": "yes", "text": "You may call again, {you}. {other}" },
    { "topic": "court", "outcome": "yes", "temper": "Pious", "text": "Will you walk with me to the chapel? {other}" },
    { "topic": "hand", "outcome": "yes", "text": "Then it is settled. Welcome to {house}. {other}" },
    { "topic": "hand", "outcome": "no", "text": "She is not for a sellsword, {you}." },
    { "topic": "hand", "outcome": "no", "temper": "Greedy", "text": "And what would you bring my house? Come back richer." }
  ]
}
