{
  // What lords say when you talk to them (docs/archive/LORDS.md LD3; Campaign/Talk.cs). Each line: a topic ("greet" for the greeting),
  // and optionally a mood towards you (warm, even, cold, hostile), a temper (one of the lord traits), an outcome (yes, no) and
  // "war": true (only while his realm is at war with yours). The most fitting lines win. {name}, {house}, {realm}, {you}, {other}.
  "lines": [
    { "topic": "greet", "mood": "warm", "text": "Well met, {you}. Sit, there is wine." },
    { "topic": "greet", "mood": "warm", "text": "{you}! The men speak of you. Come, sit by the fire." },
    { "topic": "greet", "mood": "warm", "temper": "Honourable", "text": "An honest face is rare these days. Welcome, {you}." },
    { "topic": "greet", "mood": "warm", "temper": "Greedy", "text": "My friend the {you}. Business, I hope? Good business?" },
    { "topic": "greet", "mood": "warm", "temper": "Pious", "text": "The saints walk with you, {you}. Be welcome." },
    { "topic": "greet", "mood": "even", "text": "{you}. What brings you to {house}?" },
    { "topic": "greet", "mood": "even", "text": "Speak, {you}. I have little time." },
    { "topic": "greet", "mood": "even", "temper": "Cautious", "text": "You will forgive me if my guards stay close, {you}." },
    { "topic": "greet", "mood": "even", "temper": "Ambitious", "text": "A captain with men behind him. Perhaps we can be useful to each other." },
    { "topic": "greet", "mood": "even", "temper": "Reckless", "text": "Ha! Another sellsword. Can your men fight, or only eat?" },
    { "topic": "greet", "mood": "cold", "text": "You. Say what you came to say." },
    { "topic": "greet", "mood": "cold", "temper": "Cruel", "text": "I have hanged better men than you for less, {you}." },
    { "topic": "greet", "mood": "cold", "temper": "Honourable", "text": "I will hear you, {you}, because it is right. Do not mistake it for liking." },
    { "topic": "greet", "mood": "hostile", "text": "You have a nerve, riding up to me." },
    { "topic": "greet", "mood": "hostile", "temper": "Cruel", "text": "I will remember your face when they bring me your head." },
    { "topic": "greet", "war": true, "text": "The {realm} and yours are at war, {you}. Speak quickly." },
    { "topic": "greet", "war": true, "mood": "warm", "text": "Our realms are at war, {you}, but I bear you no hate. Speak." },

    { "topic": "news", "outcome": "yes", "text": "{other}" },
    { "topic": "news", "outcome": "yes", "mood": "hostile", "text": "Why should I tell you anything? ...Still. {other}" },
    { "topic": "lords", "outcome": "yes", "text": "{other}" },
    { "topic": "lords", "outcome": "yes", "temper": "Fickle", "text": "Friends change with the wind, {you}. Today: {other}" },
    { "topic": "wants", "outcome": "yes", "text": "{other}" },
    { "topic": "wants", "outcome": "yes", "mood": "hostile", "text": "What I want is none of your business. Though since you ask: {other}" },
    { "topic": "work", "outcome": "yes", "text": "There is something. {other}" },
    { "topic": "work", "outcome": "yes", "temper": "Greedy", "text": "I pay for results, not promises. {other}" },
    { "topic": "ride", "outcome": "yes", "text": "Very well. My banner rides with yours for three days." },
    { "topic": "ride", "outcome": "yes", "temper": "Reckless", "text": "Ride together? Gladly! Let us find someone to kill." },
    { "topic": "ride", "outcome": "no", "text": "I have my own road, {you}." },
    { "topic": "council", "outcome": "yes", "text": "When the council sits, I will speak for you." },
    { "topic": "council", "outcome": "yes", "temper": "Ambitious", "text": "I will back you. Remember who did, when you rise." },
    { "topic": "council", "outcome": "no", "text": "I owe you nothing in council." },
    { "topic": "peace", "outcome": "yes", "text": "Enough men have died. {other}" },
    { "topic": "peace", "outcome": "yes", "temper": "Cautious", "text": "You speak sense. This war bleeds us both. {other}" },
    { "topic": "peace", "outcome": "no", "text": "Peace? When we have won it, not before." },
    { "topic": "peace", "outcome": "no", "temper": "Reckless", "text": "Peace is for old men. I have battles yet to win." },
    { "topic": "defect", "outcome": "yes", "text": "My king has never valued me. Very well: I am yours." },
    { "topic": "defect", "outcome": "no", "text": "I swore an oath, {you}. Do not ask me again." },
    { "topic": "defect", "outcome": "no", "temper": "Honourable", "text": "You would have me break faith? Get out of my sight." },
    { "topic": "demand", "outcome": "yes", "text": "...Take it, and go. {other}" },
    { "topic": "demand", "outcome": "no", "text": "You will have steel, not silver." },
    { "topic": "demand", "outcome": "no", "temper": "Reckless", "text": "Ha! Come and take it, then!" },
    { "topic": "gift", "outcome": "yes", "text": "Generous of you, {you}." },
    { "topic": "gift", "outcome": "yes", "temper": "Greedy", "text": "Ah. Now you speak a language I understand." },
    { "topic": "gift", "outcome": "yes", "temper": "Generous", "text": "Keep your gold, {you}... no? Then I thank you." },
    { "topic": "gift_horse", "outcome": "yes", "text": "A fine beast. I will ride her into battle." },
    { "topic": "gift_horse", "outcome": "yes", "temper": "Cautious", "text": "A horse. Useful. Thank you." },
    { "topic": "insult", "outcome": "yes", "text": "You will regret those words." },
    { "topic": "insult", "outcome": "yes", "temper": "Reckless", "text": "Draw, then, if you dare say it again!" },
    { "topic": "insult", "outcome": "yes", "temper": "Cautious", "text": "Words cost nothing. Their price comes later." },
    { "topic": "court", "outcome": "yes", "text": "You may call again, {you}. {other}" },
    { "topic": "court", "outcome": "yes", "temper": "Pious", "text": "Will you walk with me to the chapel? {other}" },
    { "topic": "hand", "outcome": "yes", "text": "Then it is settled. Welcome to {house}. {other}" },
    { "topic": "hand", "outcome": "no", "text": "She is not for a sellsword, {you}." },
    { "topic": "hand", "outcome": "no", "temper": "Greedy", "text": "And what would you bring my house? Come back richer." },
    // Your own men at the camp (docs/pre-demo/COMPANY.md C5; Campaign/CampTalk.cs): topics man_greet, man_men, man_home, man_tie.
    // "when" is what is true now (man_men: hungry, unpaid, won, lost, low, high; man_home: far, near; man_tie: the tie's kind),
    // "nature" his nature. The most fitting lines win. {man}, {other}, {company}, {home}, {foe}, {you}.
    {"topic": "man_greet", "text": "Captain."},
    {"topic": "man_greet", "text": "Sit if you like. The fire's warm enough."},
    {"topic": "man_greet", "nature": "Steady", "text": "All quiet on this side, captain."},
    {"topic": "man_greet", "nature": "Bold", "text": "When do we march?"},
    {"topic": "man_greet", "nature": "Grim", "text": "You've come to count us. We're all here."},
    {"topic": "man_greet", "nature": "Merry", "text": "Captain! Take a cup. It's mostly water."},
    {"topic": "man_greet", "nature": "Pious", "text": "God keep you, captain."},
    {"topic": "man_greet", "nature": "Sly", "text": "Captain. If anyone asks, I was here all night."},
    {"topic": "man_greet", "nature": "Proud", "text": "Come to see the best of them, captain?"},
    {"topic": "man_greet", "nature": "Gentle", "text": "Mind the lad asleep there, captain."},
    {"topic": "man_greet", "when": "won", "text": "We gave {foe} something to remember."},
    {"topic": "man_greet", "when": "won", "nature": "Proud", "text": "Did you see it, captain? I was at the front of it."},
    {"topic": "man_greet", "when": "won", "nature": "Merry", "text": "They're singing at the next fire already. Badly."},
    {"topic": "man_greet", "when": "lost", "text": "We left good men out there."},
    {"topic": "man_greet", "when": "lost", "nature": "Bold", "text": "Give me another go at them."},
    {"topic": "man_greet", "when": "lost", "nature": "Grim", "text": "Count us again in the morning. Some of the hurt won't see it."},
    {"topic": "man_greet", "when": "hurt", "text": "It looks worse than it is."},
    {"topic": "man_greet", "when": "hurt", "nature": "Grim", "text": "The surgeon says I'll keep the arm. He said that to the last one."},
    {"topic": "man_greet", "when": "hurt", "nature": "Gentle", "text": "See to the others first, captain."},
    {"topic": "man_men", "text": "Fed, dry and bored. You could do worse."},
    {"topic": "man_men", "text": "They grumble. They always grumble. It means nothing."},
    {"topic": "man_men", "nature": "Steady", "text": "Steady. Nothing to fear from them."},
    {"topic": "man_men", "when": "hungry", "text": "The bread's gone and the men know it. Get us food, or they'll find their own."},
    {"topic": "man_men", "when": "hungry", "nature": "Grim", "text": "Hungry. I've seen men eat their belts. We're not there yet."},
    {"topic": "man_men", "when": "unpaid", "text": "No pay again. They ask me where it went. I tell them I don't know."},
    {"topic": "man_men", "when": "unpaid", "nature": "Sly", "text": "Some are selling their kit for dice money. You didn't hear it from me."},
    {"topic": "man_men", "when": "won", "text": "Happy. A win does more for them than a week's rest."},
    {"topic": "man_men", "when": "won", "nature": "Merry", "text": "Loud. Let them be loud tonight, captain."},
    {"topic": "man_men", "when": "lost", "text": "Quiet. Nobody wants to say the names yet."},
    {"topic": "man_men", "when": "lost", "nature": "Pious", "text": "We said the words for them. It helps a little."},
    {"topic": "man_men", "when": "low", "text": "Thin. Some of them would walk off tonight if the road were dark enough."},
    {"topic": "man_men", "when": "low", "nature": "Merry", "text": "Low. I tried a song. Nobody sang."},
    {"topic": "man_men", "when": "high", "text": "As good as I've seen them. They'd follow you into a river."},
    {"topic": "man_men", "when": "high", "nature": "Grim", "text": "Too cheerful. It won't last."},
    {"topic": "man_home", "text": "{home}. Small place. You'd ride through it without stopping."},
    {"topic": "man_home", "text": "{home}. My mother still thinks I'm a ploughman."},
    {"topic": "man_home", "nature": "Pious", "text": "{home}. There's a chapel there my father built with his own hands."},
    {"topic": "man_home", "nature": "Proud", "text": "{home}. They'll put my name on the church door one day."},
    {"topic": "man_home", "nature": "Grim", "text": "{home}. Nothing to go back to."},
    {"topic": "man_home", "nature": "Gentle", "text": "{home}. I left a sister there. She sends word when someone will write it for her."},
    {"topic": "man_home", "when": "far", "text": "{home}, a long way from here. I don't think about it much."},
    {"topic": "man_home", "when": "near", "text": "{home}. It isn't far. I could walk there by morning, if you let me."},
    {"topic": "man_tie", "when": "Brothers", "text": "{other}? He stood by me when the line broke. I'd do the same for him."},
    {"topic": "man_tie", "when": "Kin", "text": "{other} is my cousin. Our mothers would skin me if I came home without him."},
    {"topic": "man_tie", "when": "Rivals", "text": "{other} counts his kills out loud. I count mine quietly. I've more."},
    {"topic": "man_tie", "when": "Rivals", "nature": "Proud", "text": "{other}? Ask him how many he took last time. Then ask me."},
    {"topic": "man_tie", "when": "Master", "text": "{other} is learning. Slowly. He'll make a soldier if he lives."},
    {"topic": "man_tie", "when": "Lad", "text": "{other} taught me to hold a spear. He still shouts at me for it."},
    // A named man in battle (C6, BattleNamed.cs): by nature only.
    {"topic": "man_felled_captain", "text": "Their captain's down!"},
    {"topic": "man_felled_captain", "nature": "Steady", "text": "Their captain is down. Hold the line."},
    {"topic": "man_felled_captain", "nature": "Bold", "text": "Their captain's down! Follow me!"},
    {"topic": "man_felled_captain", "nature": "Grim", "text": "That's their captain. Who's next?"},
    {"topic": "man_felled_captain", "nature": "Merry", "text": "Their captain! Someone owes me a drink!"},
    {"topic": "man_felled_captain", "nature": "Pious", "text": "Their captain is fallen. God judge him."},
    {"topic": "man_felled_captain", "nature": "Sly", "text": "Their captain's down. Check his purse later."},
    {"topic": "man_felled_captain", "nature": "Proud", "text": "I killed their captain! Remember that!"},
    {"topic": "man_felled_captain", "nature": "Gentle", "text": "Their captain is down. Let them yield."},
    {"topic": "man_felled_horse", "text": "Got the rider!"},
    {"topic": "man_felled_horse", "nature": "Steady", "text": "Rider down. Close up."},
    {"topic": "man_felled_horse", "nature": "Bold", "text": "Pulled him out of the saddle!"},
    {"topic": "man_felled_horse", "nature": "Grim", "text": "Got the horseman. Next."},
    {"topic": "man_felled_horse", "nature": "Merry", "text": "He came off his horse like a sack of turnips!"},
    {"topic": "man_felled_horse", "nature": "Pious", "text": "The rider has fallen."},
    {"topic": "man_felled_horse", "nature": "Sly", "text": "Took his legs out. He never saw me."},
    {"topic": "man_felled_horse", "nature": "Proud", "text": "Their rider was no match for me!"},
    {"topic": "man_felled_horse", "nature": "Gentle", "text": "He's off his horse. Leave the horse be."},
    {"topic": "man_brother_down", "text": "{other}! They got {other}!"},
    {"topic": "man_brother_down", "nature": "Steady", "text": "{other} is down. Keep your places."},
    {"topic": "man_brother_down", "nature": "Bold", "text": "{other}! I'll kill them for this!"},
    {"topic": "man_brother_down", "nature": "Grim", "text": "They killed {other}. They will pay for it."},
    {"topic": "man_brother_down", "nature": "Merry", "text": "No... not {other}."},
    {"topic": "man_brother_down", "nature": "Pious", "text": "{other} is down. God keep him."},
    {"topic": "man_brother_down", "nature": "Sly", "text": "{other}'s down. I saw who did it."},
    {"topic": "man_brother_down", "nature": "Proud", "text": "They dare kill {other}? Come on, then!"},
    {"topic": "man_brother_down", "nature": "Gentle", "text": "{other}! Someone get to him!"},
    {"topic": "man_saved", "text": "Got me out... I live."},
    {"topic": "man_saved", "nature": "Steady", "text": "I'm up. Back to the line."},
    {"topic": "man_saved", "nature": "Bold", "text": "On my feet. Let me at them again!"},
    {"topic": "man_saved", "nature": "Grim", "text": "Not dead yet."},
    {"topic": "man_saved", "nature": "Merry", "text": "Thought I was done for! Not today!"},
    {"topic": "man_saved", "nature": "Pious", "text": "Saved. God be thanked, and you, captain."},
    {"topic": "man_saved", "nature": "Sly", "text": "Nice timing, captain. I'll remember it."},
    {"topic": "man_saved", "nature": "Proud", "text": "I'd have got up on my own. ...Thank you."},
    {"topic": "man_saved", "nature": "Gentle", "text": "Thank you, captain. Thank you."}
  ]
}
